# Convex Backend Configuration
# Paste your Convex Deployment URL below from your Convex dashboard:
# e.g. https://your-project-id.convex.cloud
NEXT_PUBLIC_CONVEX_URL=https://small-lobster-75.eu-west-1.convex.cloud

